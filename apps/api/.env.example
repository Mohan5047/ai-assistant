# ========================================================
# Personal AI Life Assistant - Environment Configuration
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database (Cloud PostgreSQL - e.g., Neon, Supabase, Neon Serverless)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Authentication & Security
JWT_SECRET=your-secure-random-string-min-32-chars-long
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# AES-256-GCM Encryption Key for Token Storage (64-character hex string)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth & Calendar API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Background Jobs & Queues (BullMQ / Redis)
REDIS_URL=redis://localhost:6379

# AI Assistant Orchestration
OPENAI_API_KEY=sk-your-openai-or-compatible-api-key
AI_MODEL=gpt-4o-mini

# Email Notifications & Reminders (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Life Assistant" <no-reply@lifeassistant.ai>
